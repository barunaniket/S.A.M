# S.A.M environment template. Copy to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored — never commit real secrets. Keys marked REQUIRED are
# validated at startup by src/utils/config_loader.py (the app refuses to boot
# without them). Optional keys show their built-in default in a comment.

# --- Google API (REQUIRED) ---
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_PROJECT_ID=your-gcp-project-id
# Space-separated OAuth scopes.
GOOGLE_API_SCOPES=https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/gmail.send
# Optional — OAuth redirect target (must match the GCP console entry).
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Email / SMTP (REQUIRED) ---
SENDER_EMAIL=you@example.com
# Gmail App Password (not your account password).
SENDER_PASSWORD=your-16-char-app-password

# --- LLM: NVIDIA OpenAI-compatible endpoint (NVIDIA_API_KEY REQUIRED) ---
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
# Optional — defaults shown.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_ID=google/gemma-3-27b-it
# Optional — only for Google-direct (Gemini) usage.
GEMINI_API_KEY=

# --- WhatsApp Cloud API (REQUIRED) ---
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_VERIFY_TOKEN=a-random-string-you-choose
WHATSAPP_APP_SECRET=your-meta-app-secret
# Optional — Graph API version, default shown.
WHATSAPP_GRAPH_VERSION=v20.0

# --- Telegram Bot (optional — poller/routes disable themselves if unset) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT=25

# --- Database (REQUIRED) ---
# DB_* are consumed by the Postgres container in docker-compose.yml; the app
# itself reads DATABASE_URL. Keep them consistent: user/password/name below
# must match the credentials and db name embedded in DATABASE_URL.
# Inside Docker the host is the compose service name `db`; from the host
# (running scripts/uvicorn natively) use `localhost`.
DB_USER=sam
DB_PASSWORD=sam
DB_NAME=sam
DATABASE_URL=postgresql://sam:sam@db:5432/sam

# --- Auth (SECRET_KEY strongly recommended; defaults shown for the rest) ---
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Redis (optional — default shown) ---
REDIS_URL=redis://redis:6379/0

# --- Uploads (optional — default shown) ---
UPLOAD_DIR=data/uploads
